[Unit]
Description=Cosmic Scribe voice dictation daemon
Documentation=https://github.com/erik-balfe/cosmic-scribe
After=graphical-session.target com.system76.CosmicStatusNotifierWatcher.service
Wants=com.system76.CosmicStatusNotifierWatcher.service

[Service]
Type=simple
ExecStart=@bindir@/cosmic-scribe --daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=mixed
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR DISPLAY DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=graphical-session.target